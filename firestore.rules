rules_version = '2';

// Firestore のセキュリティルール。項目の定義は docs/DATA_CONTRACT.md を正とする。
// 変更したら firestore-tests/ のテストを Emulator で通してから反映する（docs/FIREBASE_SETUP.md §6）。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isText(value, maxLength) {
      return value is string && value.trim().size() > 0 && value.size() <= maxLength;
    }

    function postPath(postId) {
      return /databases/$(database)/documents/posts/$(postId);
    }

    // 匿名投稿の本人確認用。uid は本人しか読めない（DATA_CONTRACT §4）
    function ownerPath(postId) {
      return /databases/$(database)/documents/posts/$(postId)/private/owner;
    }

    // 名前つきの投稿は authorId、匿名投稿は private/owner で本人か確かめる
    // 匿名投稿の authorId は空文字なので、uid と一致することはない
    function isPostOwner(postId) {
      return get(postPath(postId)).data.authorId == request.auth.uid
        || get(ownerPath(postId)).data.uid == request.auth.uid;
    }

    match /posts/{postId} {
      // 1 件ずつの取得（投稿詳細）はログインしていればできる
      allow get: if signedIn();

      // 一覧は件数上限付きのクエリだけ。全件をまとめて取られないようにする（DATA_CONTRACT §3）
      // 閲覧者の現在地はルールから見えないので、「1km 以内だけ」までは強制できない
      // - 近くの投稿: geohash 順のクエリだけ。authorId で絞るには (authorId, geohash) の複合インデックスが要り、
      //   それを用意しないことで他人の投稿を場所に関係なく集められないようにする（#50）
      // - 自分の投稿: 自分の authorId で絞ったクエリだけ
      allow list: if signedIn()
        && request.query.limit != null
        && request.query.limit <= 100
        && ('geohash' in request.query.orderBy || resource.data.authorId == request.auth.uid);

      // 名前つきは本人の uid で、匿名は uid なし・名前「匿名」で、private/owner を同じバッチで作るときだけ作れる
      // createdAt はサーバー時刻、commentCount は 0 から
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
          ['authorId', 'authorName', 'isAnonymous', 'text', 'imageUrls', 'location', 'geohash', 'createdAt', 'commentCount'])
        && request.resource.data.keys().hasAll(
          ['authorId', 'authorName', 'isAnonymous', 'text', 'location', 'geohash', 'createdAt', 'commentCount'])
        && request.resource.data.isAnonymous is bool
        && ((!request.resource.data.isAnonymous && request.resource.data.authorId == request.auth.uid)
          || (request.resource.data.isAnonymous
            && request.resource.data.authorId == ''
            && request.resource.data.authorName == '匿名'
            && getAfter(ownerPath(postId)).data.uid == request.auth.uid))
        && request.resource.data.authorName is string
        && isText(request.resource.data.text, 500)
        && (!('imageUrls' in request.resource.data)
          || (request.resource.data.imageUrls is list && request.resource.data.imageUrls.size() <= 4))
        && request.resource.data.location is latlng
        && request.resource.data.geohash is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.commentCount == 0;

      // コメント追加時の commentCount + 1 は誰でもできる
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
        && request.resource.data.commentCount == resource.data.commentCount + 1;

      // 投稿者は本文だけ編集できる（#16）。editedAt はサーバー時刻
      allow update: if signedIn()
        && isPostOwner(postId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
        && isText(request.resource.data.text, 500)
        && request.resource.data.editedAt == request.time;

      allow delete: if signedIn() && isPostOwner(postId);

      match /private/{docId} {
        allow get: if signedIn() && docId == 'owner' && resource.data.uid == request.auth.uid;

        // 匿名投稿を作るバッチの中でだけ作れる。既存の投稿に後から付けて削除権限を奪うのを防ぐ
        allow create: if signedIn()
          && docId == 'owner'
          && request.resource.data.keys().hasOnly(['uid'])
          && request.resource.data.uid == request.auth.uid
          && !exists(postPath(postId))
          && getAfter(postPath(postId)).data.isAnonymous == true;

        allow update: if false;

        // 投稿と同じバッチでだけ消せる（owner だけ消すと、誰も投稿を消せなくなるため）
        allow delete: if signedIn()
          && resource.data.uid == request.auth.uid
          && !existsAfter(postPath(postId));
      }

      match /comments/{commentId} {
        allow read: if signedIn();

        // 投稿の commentCount を同じバッチで 1 増やしたときだけ作れる（件数がずれないように）
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'text', 'createdAt'])
          && request.resource.data.keys().hasAll(['authorId', 'authorName', 'text', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && isText(request.resource.data.text, 500)
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/posts/$(postId))
          && getAfter(/databases/$(database)/documents/posts/$(postId)).data.commentCount
            == get(/databases/$(database)/documents/posts/$(postId)).data.commentCount + 1;

        allow update: if false;

        // 投稿の削除時に、投稿者がコメントもまとめて消す
        allow delete: if signedIn() && isPostOwner(postId);
      }
    }

    // 自分の匿名投稿を探す（コレクショングループクエリ）。自分の uid で絞ったクエリだけ
    match /{path=**}/private/{docId} {
      allow list: if signedIn()
        && request.query.limit != null
        && request.query.limit <= 100
        && resource.data.uid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn();

      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'photoUrl', 'bio'])
        && request.resource.data.keys().hasAll(['displayName', 'bio'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 50
        && (!('photoUrl' in request.resource.data)
          || request.resource.data.photoUrl == null
          || request.resource.data.photoUrl is string)
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 200;

      allow delete: if false;
    }
  }
}
